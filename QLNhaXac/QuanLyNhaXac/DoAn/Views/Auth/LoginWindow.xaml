<Window x:Class="DoAn.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAn.Views.Auth"
        xmlns:vm="clr-namespace:DoAn.ViewModel"
        mc:Ignorable="d"
        x:Name="wndLogin"
        Title="LoginWindow" Height="650" Width="800">
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Border Background="White" CornerRadius="15" Margin="50" Padding="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.1" ShadowDepth="5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="QUẢN LÝ NHÀ XÁC" HorizontalAlignment="Center" FontWeight="Bold" FontSize="26" Foreground="#1F2937" Margin="0,0,0,5"/>
                <TextBlock Text="Đăng nhập để tiếp tục" HorizontalAlignment="Center" FontSize="14" Foreground="#6B7280" Margin="0,0,0,30"/>

                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,25">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <CheckBox Content="Dùng LocalDB (Windows Auth) - chỉ để debug"
                      IsChecked="{Binding UseLocalDb}"
                      Foreground="#6B7280" Margin="0,0,0,20"/>

                <Button Content="ĐĂNG NHẬP" 
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=wndLogin}"
                        Height="45" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Chưa có tài khoản? " Foreground="#6B7280"/>
                    <TextBlock>
                        <Hyperlink Command="{Binding NavigateRegisterCommand}" Foreground="#3B82F6" TextDecorations="None" FontWeight="SemiBold">
                            Đăng ký ngay
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
