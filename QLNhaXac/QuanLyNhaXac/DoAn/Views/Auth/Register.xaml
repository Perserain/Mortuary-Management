<Window x:Class="DoAn.Views.Auth.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DoAn.ViewModel"
    x:Name="wndRegister"
    Title="Đăng Ký Tài Khoản" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Grid>
        <Border Background="White" CornerRadius="15" Margin="30" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.1" ShadowDepth="5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="ĐĂNG KÝ TÀI KHOẢN" HorizontalAlignment="Center" FontWeight="Bold" FontSize="24" Foreground="#10B981" Margin="0,0,0,30"/>

                <TextBlock Text="Tên đăng nhập mới:" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,5"/>
                <TextBox Text="{Binding UsernameReg, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Mật khẩu:" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword_Re" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,25">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <Button Content="ĐĂNG KÝ NGAY" 
                        Command="{Binding RegisterCommand}" 
                        CommandParameter="{Binding ElementName=wndRegister}"
                        Height="45" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>