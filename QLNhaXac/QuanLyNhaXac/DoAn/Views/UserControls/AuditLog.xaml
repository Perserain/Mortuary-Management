<UserControl x:Class="DoAn.Views.UserControls.AuditLog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style nút action chung -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- KPI badges -->
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Detail panel + xóa log cũ -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ROW 0: TIÊU ĐỀ ===== -->
        <TextBlock Grid.Row="0"
                   Text="📋  NHẬT KÝ THAO TÁC HỆ THỐNG"
                   FontSize="24" FontWeight="Bold" Foreground="#1E293B"
                   Margin="0,0,0,14"/>

        <!-- ===== ROW 1: KPI BADGES ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">

                <!-- INSERT -->
                <Border Background="#D1FAE5" CornerRadius="8" Padding="16,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#065F46" FontSize="13">
                            <Run Text="Thêm mới: "/>
                            <Run Text="{Binding TongInsert}" FontWeight="Bold" FontSize="15"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- UPDATE -->
                <Border Background="#FEF3C7" CornerRadius="8" Padding="16,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#92400E" FontSize="13">
                            <Run Text="Cập nhật: "/>
                            <Run Text="{Binding TongUpdate}" FontWeight="Bold" FontSize="15"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- DELETE -->
                <Border Background="#FEE2E2" CornerRadius="8" Padding="16,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#991B1B" FontSize="13">
                            <Run Text="Xóa: "/>
                            <Run Text="{Binding TongDelete}" FontWeight="Bold" FontSize="15"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Tổng -->
                <Border Background="#F1F5F9" CornerRadius="8" Padding="16,8">
                    <TextBlock VerticalAlignment="Center" Foreground="#334155" FontSize="13">
                        <Run Text="Tổng hiển thị: "/>
                        <Run Text="{Binding DanhSachLog.Count, Mode=OneWay}" FontWeight="Bold" FontSize="15"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== ROW 2: FILTER BAR ===== -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.04" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bảng -->
                <TextBlock Grid.Column="0" Text="Bảng:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DanhSachTable}"
                          SelectedItem="{Binding FilterTable}"
                          Height="30" VerticalContentAlignment="Center"/>

                <!-- Từ ngày -->
                <TextBlock Grid.Column="3" Text="Từ ngày:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="4"
                            SelectedDate="{Binding TuNgay}"
                            Height="30" VerticalContentAlignment="Center"/>

                <!-- Đến ngày -->
                <TextBlock Grid.Column="6" Text="Đến ngày:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="7"
                            SelectedDate="{Binding DenNgay}"
                            Height="30" VerticalContentAlignment="Center"/>

                <!-- Số dòng -->
                <TextBlock Grid.Column="9" Text="Top:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <TextBox Grid.Column="10"
                         Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" VerticalContentAlignment="Center"
                         Padding="6,0" BorderBrush="#CBD5E1"/>

                <!-- Nút -->
                <StackPanel Grid.Column="12" Orientation="Horizontal">
                    <Button Content="🔍  Lọc"
                            Command="{Binding LocCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="#3B82F6" Margin="0,0,8,0"/>
                    <Button Content="↺  Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="#64748B"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ROW 3: DATAGRID ===== -->
        <Border Grid.Row="3" Background="White" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      SelectionMode="Single"
                      RowHeight="44"
                      ItemsSource="{Binding DanhSachLog}"
                      SelectedItem="{Binding SelectedLog}">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- Mã log -->
                    <DataGridTextColumn Header="#" Binding="{Binding MALOG}" Width="70"/>

                    <!-- Thời gian -->
                    <DataGridTextColumn Header="Thời Gian" Binding="{Binding THOIGIAN}" Width="155"/>

                    <!-- User -->
                    <DataGridTextColumn Header="Người dùng" Binding="{Binding TENUSER}" Width="130"/>

                    <!-- Bảng -->
                    <DataGridTextColumn Header="Bảng" Binding="{Binding TENTABLE}" Width="110"/>

                    <!-- Hành động — badge màu -->
                    <DataGridTemplateColumn Header="Hành Động" Width="110" SortMemberPath="HANHDOG">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="8,4"
                                        HorizontalAlignment="Left" Margin="4,0">
                                    <Border.Background>
                                        <Binding Path="MauHanhDong"/>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconHanhDong}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HANHDOG}" Foreground="White"
                                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mã bản ghi -->
                    <DataGridTextColumn Header="Mã Bản Ghi" Binding="{Binding MABANGHI}" Width="110"/>

                    <!-- Nội dung — wrap text -->
                    <DataGridTextColumn Header="Nội Dung" Binding="{Binding NOIDUNG}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="MaxHeight" Value="60"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>

                <!-- Row detail: mở rộng nội dung khi chọn dòng -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="0,1,0,0"
                                Padding="16,10" Margin="0">
                            <StackPanel>
                                <TextBlock Text="📄 Nội dung chi tiết:" FontWeight="Bold"
                                           Foreground="#0369A1" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding NOIDUNG}"
                                           TextWrapping="Wrap" Foreground="#1E3A5F"
                                           FontSize="12" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.RowDetailsVisibilityMode>VisibleWhenSelected</DataGrid.RowDetailsVisibilityMode>

            </DataGrid>
        </Border>

        <!-- ===== ROW 4: XÓA LOG CŨ (Admin only) ===== -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="16,12" Margin="0,12,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.04" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ghi chú -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#94A3B8" FontSize="12"
                           Text="ℹ️  Log được ghi tự động bởi trigger khi có INSERT / UPDATE / DELETE trên các bảng dữ liệu."/>

                <!-- Xóa log cũ -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Giữ log trong" VerticalAlignment="Center"
                               Foreground="#475569" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding SoNgayGiu, UpdateSourceTrigger=PropertyChanged}"
                             Width="50" Height="30" VerticalContentAlignment="Center"
                             Padding="6,0" BorderBrush="#CBD5E1" TextAlignment="Center"/>
                    <TextBlock Text="ngày" VerticalAlignment="Center"
                               Foreground="#475569" Margin="8,0,16,0"/>
                    <Button Content="🗑️  Xóa Log Cũ"
                            Command="{Binding XoaLogCuCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="#EF4444"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
