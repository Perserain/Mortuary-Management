<UserControl x:Class="DoAn.Views.UserControls.ThanNhan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DoAn.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:ThanNhanViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Style nút bấm chung -->
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height"      Value="32"/>
            <Setter Property="Padding"     Value="16,0"/>
            <Setter Property="Margin"      Value="6,0,0,0"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style header DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#F1F5F9"/>
            <Setter Property="Foreground"   Value="#475569"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Padding"      Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"  Value="#CBD5E1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"           Value="10,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness"   Value="0"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="LblStyle" TargetType="TextBlock">
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,10,12"/>
        </Style>
        <!-- TextBox style -->
        <Style x:Key="TxtStyle" TargetType="TextBox">
            <Setter Property="Height"                  Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                 Value="6,0"/>
            <Setter Property="BorderBrush"             Value="#CBD5E1"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Margin"                  Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Chọn thi hài -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Form thêm/sửa -->
        </Grid.RowDefinitions>

        <!-- ══════════ TIÊU ĐỀ ══════════ -->
        <TextBlock Grid.Row="0"
                   Text="QUẢN LÝ THÂN NHÂN"
                   FontSize="26" FontWeight="Bold" Foreground="#1E293B"
                   Margin="0,0,0,15"/>

        <!-- ══════════ CHỌN THI HÀI ══════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chọn thi hài:" FontWeight="SemiBold" Foreground="#475569"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox ItemsSource="{Binding DSThiHai}"
                          SelectedItem="{Binding SelectedThiHai, Mode=TwoWay}"
                          DisplayMemberPath="HoTenTH"
                          Width="280" Height="32" Margin="0,0,12,0"/>
                <Button Content="🔄 Tải lại" Style="{StaticResource BtnStyle}"
                        Background="#64748B" Command="{Binding TaiLaiCommand}"/>
                <TextBlock Text="{Binding SoLuong}" VerticalAlignment="Center"
                           Foreground="#64748B" FontWeight="SemiBold" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════ DANH SÁCH THÂN NHÂN ══════════ -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      SelectionMode="Single"
                      ItemsSource="{Binding DSThanNhan}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}">

                <DataGrid.Columns>
                    <!-- Badge ★ liên hệ chính -->
                    <DataGridTemplateColumn Header="Liên hệ" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BadgeLienHe}"
                                           Foreground="#F59E0B" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Mã TN"    Binding="{Binding MATN}"      Width="90"/>
                    <DataGridTextColumn Header="Họ tên"   Binding="{Binding HOTEN_TN}"  Width="*"/>
                    <DataGridTextColumn Header="Quan hệ"  Binding="{Binding QUANHE}"    Width="110"/>
                    <DataGridTextColumn Header="SĐT"      Binding="{Binding DIENTHOAI}" Width="115"/>
                    <DataGridTextColumn Header="Địa chỉ"  Binding="{Binding DIACHI}"    Width="180"/>
                    <DataGridTextColumn Header="Ghi chú"  Binding="{Binding GHICHU}"    Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════════ FORM THÊM / SỬA ══════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="20,16" Margin="0,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Mã TN + Họ tên -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã thân nhân:" Style="{StaticResource LblStyle}"/>
                <TextBox   Grid.Row="0" Grid.Column="1"
                           Text="{Binding MATN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           IsReadOnly="True" Background="#E2E8F0" Foreground="#475569"
                           Style="{StaticResource TxtStyle}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Họ và tên:" Style="{StaticResource LblStyle}"/>
                <TextBox   Grid.Row="0" Grid.Column="4"
                           Text="{Binding HOTEN_TN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource TxtStyle}"/>

                <!-- Row 1: Quan hệ + SĐT -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Quan hệ:" Style="{StaticResource LblStyle}"/>
                <ComboBox  Grid.Row="1" Grid.Column="1"
                           Text="{Binding QUANHE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True" Height="30" Margin="0,0,0,12">
                    <ComboBoxItem Content="Cha"/>
                    <ComboBoxItem Content="Mẹ"/>
                    <ComboBoxItem Content="Vợ/Chồng"/>
                    <ComboBoxItem Content="Con"/>
                    <ComboBoxItem Content="Anh/Chị/Em"/>
                    <ComboBoxItem Content="Ông/Bà"/>
                    <ComboBoxItem Content="Cháu"/>
                    <ComboBoxItem Content="Khác"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="Số điện thoại:" Style="{StaticResource LblStyle}"/>
                <TextBox   Grid.Row="1" Grid.Column="4"
                           Text="{Binding DIENTHOAI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource TxtStyle}"/>

                <!-- Row 2: Địa chỉ + Liên hệ chính -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Địa chỉ:" Style="{StaticResource LblStyle}"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                           Text="{Binding DIACHI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource TxtStyle}"/>

                <!-- Row 3: Ghi chú + Checkbox + Buttons -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ghi chú:" Style="{StaticResource LblStyle}"/>
                <TextBox   Grid.Row="3" Grid.Column="1"
                           Text="{Binding GHICHU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource TxtStyle}"/>

                <StackPanel Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                            Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- Checkbox người liên hệ chính -->
                    <CheckBox IsChecked="{Binding LALIENDHE, Mode=TwoWay}"
                              Content="★ Người liên hệ chính"
                              Foreground="#F59E0B" FontWeight="SemiBold"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button Content="THÊM"     Style="{StaticResource BtnStyle}"
                            Background="#10B981" Command="{Binding ThemCommand}"/>
                    <Button Content="SỬA"      Style="{StaticResource BtnStyle}"
                            Background="#F59E0B" Command="{Binding SuaCommand}"/>
                    <Button Content="XÓA"      Style="{StaticResource BtnStyle}"
                            Background="#EF4444" Command="{Binding XoaCommand}"/>
                    <Button Content="LÀM MỚI"  Style="{StaticResource BtnStyle}"
                            Background="#64748B" Command="{Binding LamMoiCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
