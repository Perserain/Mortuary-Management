<UserControl x:Class="DoAn.Views.UserControls.CanhBao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Converter: bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style chung cho nút action -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style tab toggle -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- KPI + Nút -->
            <RowDefinition Height="Auto"/>
            <!-- Tab chọn -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Footer action -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ROW 0: TIÊU ĐỀ ===== -->
        <TextBlock Grid.Row="0"
                   Text="🔔  TRUNG TÂM CẢNH BÁO HỆ THỐNG"
                   FontSize="24" FontWeight="Bold" Foreground="#1E293B"
                   Margin="0,0,0,15"/>

        <!-- ===== ROW 1: KPI HEADER + BUTTONS ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.06" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- KPI badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tổng chưa đọc -->
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="14"/>
                            <TextBlock FontSize="13" Foreground="#92400E">
                                <Run Text="{Binding TieuDeHeader}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Khẩn cấp -->
                    <Border Background="#FEE2E2" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔴 Khẩn: " FontSize="13" Foreground="#991B1B"/>
                            <TextBlock Text="{Binding SoKhanCap}" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                    <!-- Cần xử lý -->
                    <Border Background="#FFEDD5" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟠 Xử lý: " FontSize="13" Foreground="#9A3412"/>
                            <TextBlock Text="{Binding SoCanXuLy}" FontSize="13" FontWeight="Bold" Foreground="#EA580C"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄  Quét Mới"
                            Command="{Binding QuetMoiCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="#3B82F6" Margin="0,0,10,0"/>
                    <Button Content="✔  Đọc Tất Cả"
                            Command="{Binding DocTatCaCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="#10B981"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ROW 2: TAB LỌC ===== -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="6" Margin="0,0,0,12"
                HorizontalAlignment="Left">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.04" ShadowDepth="1"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Chưa đọc" Style="{StaticResource TabBtn}" IsChecked="True"
                             Checked="TabChuaDoc_Checked"/>
                <RadioButton Content="Tất cả" Style="{StaticResource TabBtn}"
                             Checked="TabTatCa_Checked"/>
            </StackPanel>
        </Border>

        <!-- ===== ROW 3: DATAGRID ===== -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      SelectionMode="Single"
                      ItemsSource="{Binding DanhSachCanhBao}"
                      SelectedItem="{Binding SelectedCanhBao}"
                      RowHeight="48">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- Cột Icon + Mức độ -->
                    <DataGridTemplateColumn Header="Mức Độ" Width="130" CanUserSort="True" SortMemberPath="MUC_DO_UU_TIEN">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="8,4"
                                        HorizontalAlignment="Left" Margin="4,0">
                                    <Border.Background>
                                        <Binding Path="MauCanhBao"/>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconCanhBao}" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MUC_DO_HIEN_THI}"
                                                   Foreground="White" FontWeight="Bold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột Thời gian -->
                    <DataGridTextColumn Header="Thời Gian" Binding="{Binding THOIGIAN}" Width="140"/>

                    <!-- Cột Thi Hài -->
                    <DataGridTextColumn Header="Thi Hài" Binding="{Binding TenThiHaiHienThi}" Width="150"/>

                    <!-- Cột Nội dung -->
                    <DataGridTextColumn Header="Nội Dung Cảnh Báo" Binding="{Binding NOIDUNG}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Cột Ngăn -->
                    <DataGridTextColumn Header="Ngăn Kéo" Binding="{Binding MANGAN}" Width="90"/>

                    <!-- Cột Trạng thái đọc -->
                    <DataGridTemplateColumn Header="Trạng Thái" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DAOC}" Value="False">
                                                    <Setter Property="Text" Value="● Mới"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DAOC}" Value="True">
                                                    <Setter Property="Text" Value="✔ Đã đọc"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== ROW 4: FOOTER ACTIONS ===== -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✔  Đánh Dấu Đã Đọc"
                    Command="{Binding DocMotCommand}"
                    Style="{StaticResource ActionBtn}"
                    Background="#F59E0B" Margin="0,0,10,0"/>
            <Button Content="🔗  Xem Thi Hài Liên Quan"
                    Command="{Binding XemThiHaiCommand}"
                    Style="{StaticResource ActionBtn}"
                    Background="#6366F1" Margin="0,0,10,0"/>
            <Button Content="↺  Làm Mới"
                    Command="{Binding LamMoiCommand}"
                    Style="{StaticResource ActionBtn}"
                    Background="#64748B"/>
        </StackPanel>
    </Grid>
</UserControl>
