<UserControl x:Class="DoAn.Views.UserControls.SuDung"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoAn.ViewModel"
             Background="#2E4053"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="850">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ DỊCH VỤ ĐÃ MUA" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mã Thi Hài:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,15"/>
                <TextBox Text="{Binding NewSuDung.MaTH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Mã Dịch Vụ:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,15"/>
                <TextBox Text="{Binding NewSuDung.MaDV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="4" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Ngày Đăng Ký:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding NewSuDung.NgaySD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,0"/>

                <TextBlock Text="Ghi Chú:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <TextBox Text="{Binding NewSuDung.GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="4" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,45,0,-45">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="80"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Margin" Value="10,0,0,0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="THÊM" Command="{Binding ThemCommand}" Background="#10B981"/>
                    <Button Content="XÓA" Command="{Binding XoaCommand}" Background="#EF4444"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" Margin="0,20,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      ItemsSource="{Binding DanhSachSuDung}" SelectedItem="{Binding SelectedSuDung}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Xác" Binding="{Binding MaTH}" Width="90"/>
                    <DataGridTextColumn Header="Tên Thi Hài" Binding="{Binding TenTH}" Width="*"/>
                    <DataGridTextColumn Header="Mã DV" Binding="{Binding MaDV}" Width="80"/>
                    <DataGridTextColumn Header="Tên Dịch Vụ" Binding="{Binding TenDV}" Width="150"/>
                    <DataGridTextColumn Header="Giá Tiền" Binding="{Binding GiaTien, StringFormat={}{0:N0} VNĐ}" Width="110" Foreground="#059669" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Ngày Đăng Ký" Binding="{Binding NgaySD, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Ghi Chú" Binding="{Binding GhiChu}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="10" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="LỊCH SỬ DỊCH VỤ THEO THI HÀI" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          ItemsSource="{Binding LichSuDichVuTheoThiHai}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Dịch Vụ" Binding="{Binding TenDV}" Width="*"/>
                        <DataGridTextColumn Header="Giá Tiền" Binding="{Binding GiaTien, StringFormat={}{0:N0} VNĐ}" Width="120" Foreground="#059669" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Ngày Sử Dụng" Binding="{Binding NgaySD, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Ghi Chú" Binding="{Binding GhiChu}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,15,0,0">
            <TextBlock Text="{Binding TongTien}" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="#EF4444"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="Margin" Value="10,0,0,0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <Button Content="TÍNH TỔNG TIỀN (THEO MÃ XÁC CHỌN)" Command="{Binding TinhTongTienCommand}" Background="#F59E0B"/>
                <Button Content="TRA CỨU LỊCH SỬ" Command="{Binding TraCuuLichSuDichVuCommand}" Background="#0EA5E9"/>
                <Button Content="NHẬP EXCEL" Command="{Binding NhapTuFileCommand}" Background="#8B5CF6"/>
                <Button Content="BÁO CÁO EXCEL" Command="{Binding XuatExcelCommand}" Background="#3B82F6"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>