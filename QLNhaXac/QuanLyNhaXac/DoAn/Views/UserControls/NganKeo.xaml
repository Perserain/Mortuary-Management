<UserControl x:Class="DoAn.Views.UserControls.NganKeo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoAn.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ NGĂN KÉO LẠNH" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mã Ngăn:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,15"/>
                <TextBox Text="{Binding NewNganKeo.MaNgan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
         IsReadOnly="True" Background="#E2E8F0" Foreground="#475569" 
         Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Vị Trí:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,15"/>
                <TextBox Text="{Binding NewNganKeo.ViTri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="4" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Nhiệt Độ (°C):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <TextBox Text="{Binding NewNganKeo.NhietDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,0"/>

                <TextBlock Text="Mã Thi Hài Nằm:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <TextBox Text="{Binding NewNganKeo.MaTH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="4" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,0"/>

                <!-- S2-04: Ngưỡng nhiệt độ cảnh báo -->
                <TextBlock Text="Ngưỡng Cảnh Báo (°C):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#D97706" Margin="0,10,10,0"/>
                <TextBox Text="{Binding NewNganKeo.NhietDoCanhBao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         ToolTip="Nhập ngưỡng nhiệt độ cảnh báo (°C). Để trống nếu không cần cảnh báo."/>
                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="80"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Margin" Value="10,0,0,0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="THÊM" Command="{Binding ThemCommand}" Background="#10B981"/>
                    <Button Content="SỬA" Command="{Binding SuaCommand}" Background="#F59E0B"/>
                    <Button Content="XÓA" Command="{Binding XoaCommand}" Background="#EF4444"/>
                </StackPanel>

                <TextBlock Text="Trạng Thái:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,12,10,0"/>
                <TextBox Text="{Binding TrangThaiNganKeo}" Grid.Row="3" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,12,0,0" IsReadOnly="True" Background="#E2E8F0" Foreground="#475569"/>
                <StackPanel Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="140"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Margin" Value="10,0,0,0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="XEM TRẠNG THÁI" Command="{Binding CapNhatTrangThaiCommand}" Background="#0EA5E9"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" Margin="0,20,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      ItemsSource="{Binding DanhSachNganKeo}" SelectedItem="{Binding SelectedNganKeo}">
                <!-- S2-04: Tô đỏ hàng khi nhiệt độ vượt ngưỡng cảnh báo -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Setter Property="ToolTip" Value="⚠️ Nhiệt độ vượt ngưỡng cảnh báo!"/>
                            </DataTrigger>
                            <!-- S3-03: Tô vàng hàng khi ngăn quá hạn bảo trì -->
                            <DataTrigger Binding="{Binding IsBaoTriOverdue}" Value="True">
                                <Setter Property="Background" Value="#FEF9C3"/>
                                <Setter Property="ToolTip" Value="🔧 Ngăn kéo đã quá hạn bảo trì!"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding XemChiTietCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Ngăn" Binding="{Binding MaNgan}" Width="100"/>
                    <DataGridTextColumn Header="Vị Trí" Binding="{Binding ViTri}" Width="150"/>
                    <DataGridTextColumn Header="Nhiệt Độ" Binding="{Binding NhietDo, StringFormat={}{0} °C}" Width="100" FontWeight="SemiBold" Foreground="#3B82F6"/>
                    <!-- S2-04: Cột ngưỡng cảnh báo -->
                    <DataGridTextColumn Header="Ngưỡng Cảnh Báo" Binding="{Binding NhietDoCanhBao, StringFormat={}{0} °C, TargetNullValue='—'}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D97706"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Mã Thi Hài (Người đang nằm)" Binding="{Binding MaTH}" Width="*"/>
                    <!-- S3-03: Cột ngày bảo trì -->
                    <DataGridTextColumn Header="Ngày Bảo Trì" Binding="{Binding NgayBaoTri, StringFormat=dd/MM/yyyy, TargetNullValue='Chưa đặt'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#92400E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="Padding" Value="15,0"/>
                    <Setter Property="Margin" Value="10,0,0,0"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <!-- S3-03: Tóm tắt bảo trì -->
            <TextBlock Text="{Binding TomTatBaoTri}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,15,0"/>
            <Button Content="🔧 Ghi Nhận Bảo Trì" Command="{Binding GhiNhanBaoTriCommand}" Background="#D97706"/>
            <Button Content="NGĂN TRỐNG" Command="{Binding LocNganKeoTrongCommand}" Background="#F97316"/>
            <Button Content="TẤT CẢ" Command="{Binding LoadCommand}" Background="#64748B"/>
            <Button Content="NHẬP EXCEL" Command="{Binding NhapTuFileCommand}" Background="#8B5CF6"/>
            <Button Content="XUẤT EXCEL" Command="{Binding XuatExcelCommand}" Background="#3B82F6"/>
        </StackPanel>
    </Grid>
</UserControl>