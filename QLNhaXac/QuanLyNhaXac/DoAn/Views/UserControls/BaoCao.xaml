<UserControl x:Class="DoAn.Views.UserControls.BaoCao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DoAn.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.DataContext>
        <vm:BaoCaoViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height"      Value="34"/>
            <Setter Property="Padding"     Value="16,0"/>
            <Setter Property="Margin"      Value="0,0,8,0"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#1E293B"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Padding"      Value="10,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"           Value="10,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness"   Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar năm + nút -->
            <RowDefinition Height="*"/>
            <!-- Tab + DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer thông báo -->
        </Grid.RowDefinitions>

        <!-- ══════════ TIÊU ĐỀ ══════════ -->
        <TextBlock Grid.Row="0"
                   Text="📊 BÁO CÁO THỐNG KÊ"
                   FontSize="26" FontWeight="Bold" Foreground="#1E293B"
                   Margin="0,0,0,15"/>

        <!-- ══════════ TOOLBAR ══════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Năm:" FontWeight="SemiBold" Foreground="#475569"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding DSNam}"
                          SelectedItem="{Binding NamChon, Mode=TwoWay}"
                          Width="90" Height="32" Margin="0,0,20,0"/>

                <Button Content="📋 Thi Hài theo tháng" Style="{StaticResource BtnStyle}"
                        Background="#6366F1" Command="{Binding LoadThiHaiCommand}"
                        Click="TabThiHai_Click"/>
                <Button Content="💰 Doanh Thu theo tháng" Style="{StaticResource BtnStyle}"
                        Background="#10B981" Command="{Binding LoadDoanhThuCommand}"
                        Click="TabDoanhThu_Click"/>
                <Button Content="👤 KPI Nhân Viên" Style="{StaticResource BtnStyle}"
                        Background="#F59E0B" Command="{Binding LoadNhanVienCommand}"
                        Click="TabNhanVien_Click"/>

                <Separator Width="1" Background="#E2E8F0" Margin="8,4,16,4"/>

                <Button Content="📥 Xuất Excel" Style="{StaticResource BtnStyle}"
                        Background="#0F766E" Command="{Binding XuatExcelCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════ TAB CONTROL ══════════ -->
        <TabControl x:Name="MainTabControl" Grid.Row="2"
                    SelectionChanged="MainTabControl_SelectionChanged"
                    Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Thi Hài -->
            <TabItem Header="📋 Thi Hài theo Tháng">
                <Border Background="White" Padding="10">
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              ItemsSource="{Binding KetQuaThiHai}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Năm"           Binding="{Binding Col1}" Width="70"/>
                            <DataGridTextColumn Header="Tháng"         Binding="{Binding Col2}" Width="70"/>
                            <DataGridTextColumn Header="Tổng thi hài"  Binding="{Binding Col3}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nam"           Binding="{Binding Col4}" Width="70"/>
                            <DataGridTextColumn Header="Nữ"            Binding="{Binding Col5}" Width="70"/>
                            <DataGridTextColumn Header="Vị thành niên" Binding="{Binding Col6}" Width="120"/>
                            <DataGridTextColumn Header="Trưởng thành"  Binding="{Binding Col7}" Width="110"/>
                            <DataGridTextColumn Header="Cao tuổi"      Binding="{Binding Col8}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Tab 2: Doanh Thu -->
            <TabItem Header="💰 Doanh Thu theo Tháng">
                <Border Background="White" Padding="10">
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              ItemsSource="{Binding KetQuaDoanhThu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Năm"            Binding="{Binding Col1}" Width="70"/>
                            <DataGridTextColumn Header="Tháng"          Binding="{Binding Col2}" Width="70"/>
                            <DataGridTextColumn Header="Số hóa đơn"     Binding="{Binding Col3}" Width="100"/>
                            <DataGridTextColumn Header="Tổng doanh thu" Binding="{Binding Col4}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đã thanh toán"   Binding="{Binding Col5}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Chưa thanh toán" Binding="{Binding Col6}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Tab 3: Nhân Viên -->
            <TabItem Header="👤 KPI Nhân Viên">
                <Border Background="White" Padding="10">
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              ItemsSource="{Binding KetQuaNhanVien}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhân viên"           Binding="{Binding Col1}" Width="*"/>
                            <DataGridTextColumn Header="Tổng HĐ"             Binding="{Binding Col2}" Width="90"/>
                            <DataGridTextColumn Header="Đã TT"               Binding="{Binding Col3}" Width="80"/>
                            <DataGridTextColumn Header="Chưa TT"             Binding="{Binding Col4}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Doanh thu thu được"  Binding="{Binding Col5}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ══════════ FOOTER ══════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16,10" Margin="0,10,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.04" ShadowDepth="1"/>
            </Border.Effect>
            <TextBlock Text="{Binding ThongBao}" FontWeight="SemiBold" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>
