<UserControl x:Class="DoAn.Views.UserControls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Converter bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style chung cho KPI Card -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Color="#000" Opacity="0.08" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style tiêu đề KPI -->
        <Style x:Key="KpiTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Style số KPI -->
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Style panel chart -->
        <Style x:Key="ChartPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#000" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- KPI row 1 -->
            <RowDefinition Height="Auto"/>
            <!-- KPI row 2 -->
            <RowDefinition Height="*"/>
            <!-- Charts -->
            <RowDefinition Height="Auto"/>
            <!-- Alerts table -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1E293B" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📊 DASHBOARD TỔNG QUAN"
                               FontSize="20" FontWeight="Black"
                               Foreground="#10B981"/>
                    <TextBlock x:Name="TxtLastRefresh"
                               Text="{Binding LastRefresh, StringFormat='Cập nhật lúc: {0}'}"
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Loading indicator -->
                    <TextBlock Text="⟳ Đang tải..." Foreground="#F59E0B" FontSize="12"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="🔄 Làm Mới"
                            Command="{Binding RefreshCommand}"
                            Background="#10B981" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"
                            Padding="16,8" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ KPI ROW 1: Thi hài + Ngăn kéo ══════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="20,16,20,0">
            <StackPanel Orientation="Horizontal">

                <!-- Tổng thi hài -->
                <Border Style="{StaticResource KpiCard}" Background="#1E293B">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="TỔNG THI HÀI"/>
                        <TextBlock Style="{StaticResource KpiValue}"
                                   Text="{Binding Kpi.TongThiHai}"/>
                        <TextBlock Text="người" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Đang bảo quản -->
                <Border Style="{StaticResource KpiCard}" Background="#0F766E">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="ĐANG BẢO QUẢN"/>
                        <TextBlock Style="{StaticResource KpiValue}"
                                   Text="{Binding Kpi.DangBaoQuan}"/>
                        <TextBlock Text="trong kho lạnh" Foreground="#99F6E4" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Chờ thanh lý -->
                <Border Style="{StaticResource KpiCard}" Background="#B45309">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="CHỜ THANH LÝ"/>
                        <TextBlock Style="{StaticResource KpiValue}"
                                   Text="{Binding Kpi.ChoThanhLy}"/>
                        <TextBlock Text="chờ bàn giao" Foreground="#FDE68A" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ngăn kéo trống -->
                <Border Style="{StaticResource KpiCard}" Background="#1D4ED8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="NGĂN KÉO TRỐNG"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource KpiValue}"
                                       Text="{Binding Kpi.NganKeoTrong}"/>
                            <TextBlock Text=" / " Foreground="#93C5FD" FontSize="20"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TongNganKeo}"
                                       Foreground="#93C5FD" FontSize="20"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="còn trống" Foreground="#BFDBFE" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ KPI ROW 2: Tài chính + Cảnh báo ═════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="20,10,20,0">
            <StackPanel Orientation="Horizontal">

                <!-- Doanh thu hôm nay -->
                <Border Style="{StaticResource KpiCard}" Background="#065F46">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="DOANH THU HÔM NAY"/>
                        <TextBlock Style="{StaticResource KpiValue}"
                                   Text="{Binding Kpi.DoanhThuHomNay, StringFormat='{}{0:N0}₫'}"/>
                        <TextBlock Text="thu trong ngày" Foreground="#6EE7B7" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Doanh thu tháng -->
                <Border Style="{StaticResource KpiCard}" Background="#166534">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="DOANH THU THÁNG"/>
                        <TextBlock Style="{StaticResource KpiValue}"
                                   Text="{Binding Kpi.DoanhThuThang, StringFormat='{}{0:N0}₫'}"/>
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='tháng {0:M/yyyy}'}"
                                   Foreground="#86EFAC" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Cảnh báo chưa đọc -->
                <Border Style="{StaticResource KpiCard}" Background="#7F1D1D">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="CẢNH BÁO CHƯA ĐỌC"/>
                        <TextBlock Style="{StaticResource KpiValue}"
                                   Text="{Binding Kpi.SoCanhBaoChuaDoc}" Foreground="#FCA5A5"/>
                        <TextBlock Text="cần xử lý" Foreground="#FCA5A5" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Hóa đơn chưa thanh toán -->
                <Border Style="{StaticResource KpiCard}" Background="#78350F">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="HÓA ĐƠN CHƯA THU"/>
                        <TextBlock Style="{StaticResource KpiValue}"
                                   Text="{Binding Kpi.HoaDonChuaTT}" Foreground="#FDE68A"/>
                        <TextBlock Text="hóa đơn còn nợ" Foreground="#FDE68A" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ CHARTS ROW ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Biểu đồ cột: Thi hài theo tháng -->
            <Border Grid.Column="0" Style="{StaticResource ChartPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📈 Thi Hài Theo Tháng"
                               FontWeight="Bold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,10"/>
                    <Canvas Grid.Row="1" x:Name="CanvasThiHai" Background="Transparent"
                            MinHeight="120"/>
                </Grid>
            </Border>

            <!-- Biểu đồ cột: Doanh thu theo tháng -->
            <Border Grid.Column="1" Style="{StaticResource ChartPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="💰 Doanh Thu Theo Tháng"
                               FontWeight="Bold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,10"/>
                    <Canvas Grid.Row="1" x:Name="CanvasDoanhThu" Background="Transparent"
                            MinHeight="120"/>
                </Grid>
            </Border>

            <!-- Biểu đồ tròn: Nguyên nhân tử vong -->
            <Border Grid.Column="2" Style="{StaticResource ChartPanel}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🥧 Nguyên Nhân Tử Vong"
                               FontWeight="Bold" Foreground="#1E293B" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Canvas Grid.Row="1" x:Name="CanvasPie" Background="Transparent"
                            MinHeight="110" Width="120" HorizontalAlignment="Center"/>
                    <!-- Legend -->
                    <ItemsControl Grid.Row="2" x:Name="LegendList"
                                  ItemsSource="{Binding LoaiCauTu}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding MauSac}"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock FontSize="10" Foreground="#475569"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160">
                                        <Run Text="{Binding LoaiCauTu}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding SoLuong}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ BẢNG TOP 5 CẢNH BÁO ══════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="16"
                Margin="20,12,20,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🔔 Top 5 Cảnh Báo Ưu Tiên Cao"
                           FontWeight="Bold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TopCanhBao}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          BorderThickness="0"
                          MaxHeight="160">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Thời Gian"
                                            Binding="{Binding THOIGIAN, StringFormat='HH:mm dd/MM'}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding LOAICB}" Width="120"/>
                        <DataGridTextColumn Header="Nội Dung" Binding="{Binding NOIDUNG}" Width="*"/>
                        <DataGridTemplateColumn Header="Mức Độ" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MUC_DO_HIEN_THI}" Value="Nguy hiểm">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MUC_DO_HIEN_THI}" Value="Cảnh báo">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MUC_DO_HIEN_THI}" Value="Thông báo">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding MUC_DO_HIEN_THI}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MUC_DO_HIEN_THI}" Value="Nguy hiểm">
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MUC_DO_HIEN_THI}" Value="Thông báo">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
