<UserControl x:Class="DoAn.Views.UserControls.TimKiem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔍 TÌM KIẾM TOÀN HỆ THỐNG" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <!-- Thanh tìm kiếm -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding TuKhoaTimKiem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Height="40" FontSize="15" VerticalContentAlignment="Center" Padding="10,0"
                             BorderBrush="#CBD5E1" BorderThickness="1"
                             Margin="0,0,10,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding TimKiemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="🔍 TÌM KIẾM" Command="{Binding TimKiemCommand}"
                            Height="40" Padding="20,0" Background="#3B82F6" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Grid.Column="2" Content="✕ Xóa" Command="{Binding XoaTimKiemCommand}"
                            Height="40" Padding="15,0" Background="#94A3B8" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>
                <TextBlock Text="{Binding ThongBaoKetQua}" Foreground="#64748B" FontSize="13" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Kết quả Thi Hài -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <Expander IsExpanded="True">
                <Expander.Header>
                    <TextBlock FontWeight="Bold" FontSize="14" Foreground="#1E293B">
                        <Run Text="🧟 THI HÀI ("/><Run Text="{Binding KetQuaThiHai.Count}"/><Run Text=" kết quả)"/>
                    </TextBlock>
                </Expander.Header>
                <DataGrid ItemsSource="{Binding KetQuaThiHai}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" MaxHeight="150" Margin="0,10,0,0"
                          BorderThickness="0" HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Thi Hài" Binding="{Binding MaTH}" Width="100"/>
                        <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTenTH}" Width="*"/>
                        <DataGridTextColumn Header="Giới Tính" Binding="{Binding GioiTinh}" Width="80"/>
                        <DataGridTextColumn Header="Ngày Sinh" Binding="{Binding NgaySinh, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Ngày Mất" Binding="{Binding NgayMat, StringFormat=dd/MM/yyyy}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Border>

        <!-- Kết quả Thân Nhân + Hóa Đơn -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thân Nhân -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10">
                        <Run Text="👪 THÂN NHÂN ("/><Run Text="{Binding KetQuaThanNhan.Count}"/><Run Text=" kết quả)"/>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding KetQuaThanNhan}" AutoGenerateColumns="False"
                              CanUserAddRows="False" BorderThickness="0" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã TN" Binding="{Binding MATN}" Width="80"/>
                            <DataGridTextColumn Header="Họ Tên" Binding="{Binding HOTEN_TN}" Width="*"/>
                            <DataGridTextColumn Header="SĐT" Binding="{Binding DIENTHOAI}" Width="110"/>
                            <DataGridTextColumn Header="Mã Thi Hài" Binding="{Binding MATH}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Hóa Đơn -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10">
                        <Run Text="🧾 HÓA ĐƠN ("/><Run Text="{Binding KetQuaHoaDon.Count}"/><Run Text=" kết quả)"/>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding KetQuaHoaDon}" AutoGenerateColumns="False"
                              CanUserAddRows="False" BorderThickness="0" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã HD" Binding="{Binding MAHD}" Width="80"/>
                            <DataGridTextColumn Header="Mã TH" Binding="{Binding MATH}" Width="70"/>
                            <DataGridTextColumn Header="Ngày Lập" Binding="{Binding NGAYLAP, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TONGTIEN, StringFormat={}{0:N0} đ}" Width="110"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding TRANGTHAITT}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
