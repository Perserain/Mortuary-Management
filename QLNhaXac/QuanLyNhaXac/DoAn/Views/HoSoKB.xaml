<UserControl x:Class="DoAn.QuanLy.HoSoKB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DoAn.ViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.DataContext>
        <vm:HoSoKBViewModel/>
    </UserControl.DataContext>

    <Grid Background="#2E4053" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="HỒ SƠ KHÁM NGHIỆM" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Nhập Hồ Sơ Mới" FontSize="13" Margin="0,0,0,10" Padding="10" Background="White" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã HS:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedHoSo.MaHS, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5,15,5" Height="25" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Ngày Khám:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding SelectedHoSo.TgKham, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3" Margin="0,5,0,5" Height="25" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Mã Thi Hài:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedHoSo.MaTH, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,5,15,5" Height="25" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Mã Bác Sĩ:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedHoSo.MaBS, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="0,5,0,5" Height="25" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Kết Luận:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedHoSo.KetLuan, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5,15,5" Height="25" HorizontalAlignment="Stretch"/>

                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="THÊM" Command="{Binding ThemCommand}" Width="70" Height="30" Margin="5,0" Background="#2E8B57" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="SỬA" Command="{Binding SuaCommand}" Width="70" Height="30" Margin="5,0" Background="#FFD700" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="XÓA" Command="{Binding XoaCommand}" Width="70" Height="30" Margin="5,0" Background="#DC143C" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" HeadersVisibility="Column"
                  ItemsSource="{Binding DanhSachHoSo}" SelectedItem="{Binding SelectedHoSo}">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding XemChiTietCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã HS" Binding="{Binding MaHS}" Width="80"/>
                <DataGridTextColumn Header="Ngày Khám" Binding="{Binding TgKham, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Kết Luận" Binding="{Binding KetLuan}" Width="*"/>
                <DataGridTextColumn Header="Mã Xác" Binding="{Binding MaTH}" Width="100"/>
                <DataGridTextColumn Header="Bác Sĩ" Binding="{Binding MaBS}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,10">
            <Button Content="NHẬP TỪ FILE" Command="{Binding NhapTuFileCommand}" Width="120" Height="35" Margin="5,0" Background="#32CD32" Foreground="White" FontWeight="Bold" Cursor="Hand"/>

            <Button Content="XUẤT EXCEL" Command="{Binding XuatExcelCommand}" Width="120" Height="35" Margin="5,0" Background="#008080" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>