<UserControl x:Class="DoAn.QuanLy.NganKeo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoAn.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">  

    <UserControl.DataContext>
        <vm:NganKeoViewModel/>
    </UserControl.DataContext>

    <Grid Background="#2E4053" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ NGĂN KÉO" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Thông Tin Ngăn" FontSize="13" Margin="0,0,0,10" Padding="10" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã Ngăn:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedNganKeo.MaNgan, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,5,15,5"/>

                <TextBlock Text="Vị Trí:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedNganKeo.ViTri, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3" Height="25" Margin="0,5,0,5"/>

                <TextBlock Text="Nhiệt Độ:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedNganKeo.NhietDo, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,5,15,5"/>

                <TextBlock Text="Mã Thi Hài:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedNganKeo.MaTH, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Height="25" Margin="0,5,0,5" ToolTip="Nhập mã xác chết nằm trong ngăn này (Nếu có)"/>

                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="THÊM" Command="{Binding ThemCommand}" Width="70" Height="30" Margin="5,0" Background="#2E8B57" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="SỬA" Command="{Binding SuaCommand}" Width="70" Height="30" Margin="5,0" Background="#FFD700" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="XÓA" Command="{Binding XoaCommand}" Width="70" Height="30" Margin="5,0" Background="#DC143C" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" HeadersVisibility="Column"
                  ItemsSource="{Binding DanhSachNganKeo}" SelectedItem="{Binding SelectedNganKeo}">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding XemChiTietCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Ngăn" Binding="{Binding MaNgan}" Width="80"/>
                <DataGridTextColumn Header="Vị Trí" Binding="{Binding ViTri}" Width="*"/>
                <DataGridTextColumn Header="Nhiệt Độ" Binding="{Binding NhietDo}" Width="80"/>
                <DataGridTextColumn Header="Người Đang Nằm" Binding="{Binding MaTH}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,10">
            <Button Content="NHẬP TỪ FILE" Command="{Binding NhapTuFileCommand}" Width="120" Height="35" Margin="5,0" Background="#32CD32" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            <Button Content="XUẤT EXCEL" Command="{Binding XuatExcelCommand}" Width="120" Height="35" Margin="5,0" Background="#008080" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>