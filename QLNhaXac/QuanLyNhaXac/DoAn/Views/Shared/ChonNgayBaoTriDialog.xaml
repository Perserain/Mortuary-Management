<Window x:Class="DoAn.Views.Shared.ChonNgayBaoTriDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghi Nhận Lịch Bảo Trì" Height="200" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TieuDe" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Ngày bảo trì:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <DatePicker x:Name="NgayBaoTriPicker" Height="30" Width="180"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Lưu ý: Chọn ngày bảo trì dự kiến hoặc ngày đã bảo trì xong." 
                   Foreground="#94A3B8" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="✔ Xác Nhận" Click="XacNhan_Click"
                    Height="35" Padding="15,0" Background="#3B82F6" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
            <Button Content="Hủy" Click="Huy_Click"
                    Height="35" Padding="15,0" Background="#94A3B8" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
