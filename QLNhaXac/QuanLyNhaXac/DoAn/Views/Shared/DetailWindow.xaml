<Window x:Class="DoAn.Views.Shared.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Thông Tin" Height="550" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI"
        WindowStyle="ToolWindow">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="15" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.1" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtTitle" Text="CHI TIẾT THÔNG TIN" 
                           FontSize="22" FontWeight="Bold" Foreground="#10B981" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlContent" Orientation="Vertical" Margin="10">
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" Content="ĐÓNG" Click="Button_Click" 
                        Height="40" Width="120" Background="#EF4444" Foreground="White" 
                        FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Margin="0,20,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>