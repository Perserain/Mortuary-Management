<UserControl x:Class="DoAn.QuanLy.BacSi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoAn.ViewModel" mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.DataContext>
        <vm:BacSiViewModel/>
    </UserControl.DataContext>

    <Grid Background="#2E4053" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ BÁC SĨ" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" Grid.Row="0"/>

        <GroupBox Header="Thông tin Bác Sĩ" FontSize="13" Grid.Row="1" Margin="10,10,10,10" Padding="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mã BS:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedBacSi.MaBS, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5,15,5" Height="25"/>

                <TextBlock Text="Họ Tên:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedBacSi.HoTenBS, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3" Margin="0,5,0,5" Height="25"/>

                <TextBlock Text="Chuyên Khoa:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedBacSi.ChuyenKhoa, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,5,15,5" Height="25"/>

                <TextBlock Text="Kinh Nghiệm:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedBacSi.NamKinhNghiem, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="0,5,0,5" Height="25"/>

                <TextBlock Text="Mã Trưởng Khoa:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedBacSi.MaTruongKhoa, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5,15,5" Height="25"/>

                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="THÊM" Command="{Binding ThemCommand}" Width="70" Height="30" Margin="5,0" Background="#2E8B57" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="SỬA" Command="{Binding SuaCommand}" Width="70" Height="30" Margin="5,0" Background="#FFD700" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="XÓA" Command="{Binding XoaCommand}" Width="70" Height="30" Margin="5,0" Background="#DC143C" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" HeadersVisibility="Column"
                  ItemsSource="{Binding DanhSachBacSi}"
                  SelectedItem="{Binding SelectedBacSi}">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding XemChiTietCommand}"/>
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã BS" Binding="{Binding MaBS}" Width="80"/>
                <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTenBS}" Width="*"/>
                <DataGridTextColumn Header="Chuyên Khoa" Binding="{Binding ChuyenKhoa}" Width="150"/>
                <DataGridTextColumn Header="Kinh Nghiệm" Binding="{Binding NamKinhNghiem}" Width="100"/>
                <DataGridTextColumn Header="Mã Trưởng Khoa" Binding="{Binding MaTruongKhoa}" Width="110"/>
                <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding CapBac}" Width="120" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
            <Button Content="NHẬP TỪ FILE" Command="{Binding NhapTuFileCommand}" Width="120" Height="35" Margin="5,0" Background="#32CD32" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            <Button Content="XUẤT EXCEL" Command="{Binding XuatExcelCommand}" Width="120" Height="35" Margin="5,0" Background="#008080" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            <Button Content="LÃO LÀNG" Command="{Binding XuatLaoLangCommand}" Width="120" Height="35" Margin="5,0" Background="#FF8C00" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>