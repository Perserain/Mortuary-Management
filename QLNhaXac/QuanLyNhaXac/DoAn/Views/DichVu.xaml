<UserControl x:Class="DoAn.QuanLy.DichVu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DoAn.ViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.DataContext>
        <vm:DichVuViewModel/>
    </UserControl.DataContext>

    <Grid Background="#2E4053" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ DỊCH VỤ" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" Grid.Row="0"/>

        <GroupBox Header="Thông Tin Dịch Vụ" FontSize="13" Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="White" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mã DV:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedDichVu.MaDV, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5,15,5" Height="25" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Tên DV:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedDichVu.TenDV, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3" Margin="0,5,0,5" Height="25" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Giá Tiền:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="Bold"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,5,15,5" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SelectedDichVu.GiaTien, UpdateSourceTrigger=PropertyChanged}" Height="25" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="VNĐ" Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold" Foreground="#2E8B57"/>
                </Grid>

                <StackPanel x:Name="StPanelNut" Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="THÊM" Command="{Binding ThemCommand}" Width="70" Height="30" Margin="5,0" Background="#2E8B57" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="SỬA" Command="{Binding SuaCommand}" Width="70" Height="30" Margin="5,0" Background="#FFD700" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="XÓA" Command="{Binding XoaCommand}" Width="70" Height="30" Margin="5,0" Background="#DC143C" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" HeadersVisibility="Column"
                  ItemsSource="{Binding DanhSachDichVu}" SelectedItem="{Binding SelectedDichVu}">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding XemChiTietCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã DV" Binding="{Binding MaDV}" Width="100"/>
                <DataGridTextColumn Header="Tên Dịch Vụ" Binding="{Binding TenDV}" Width="*"/>
                <DataGridTextColumn Header="Giá Tiền" Binding="{Binding GiaTien, StringFormat={}{0:N0} VNĐ}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="StPanelChucNang" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,10">
            <Button Content="DỊCH VỤ Ế" Command="{Binding DichVuECommand}" Width="120" Height="35" Margin="5,0" Background="#708090" Foreground="White" FontWeight="Bold" Cursor="Hand"/>

            <Button Content="NHẬP TỪ FILE" Command="{Binding NhapTuFileCommand}" Width="120" Height="35" Margin="5,0" Background="#32CD32" Foreground="White" FontWeight="Bold" Cursor="Hand"/>

            <Button Content="XUẤT EXCEL" Command="{Binding XuatExcelCommand}" Width="120" Height="35" Margin="5,0" Background="#008080" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>