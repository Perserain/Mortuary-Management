<Window x:Class="DoAn.Views.Doctor.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DoAn.ViewModel"
        xmlns:vmDoctor="clr-namespace:DoAn.ViewModel.Doctor"
        xmlns:views="clr-namespace:DoAn.Views.UserControls"
        x:Name="wndDoctor"
        Title="Bác Sĩ - Pháp Y" Height="650" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vmDoctor:DoctorMainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ThiHaiViewModel}">
            <views:ThiHai/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CanhBaoViewModel}">
            <views:CanhBao/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HoSoKBViewModel}">
            <views:HoSoKB/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#064E3B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Logo -->
                <StackPanel Grid.Row="0" Margin="0,40,0,30">
                    <!-- Icon bác sĩ -->
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="#065F46" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🩺" FontSize="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BÁC SĨ" Foreground="#6EE7B7"
                               FontSize="22" FontWeight="Black"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="PHÁP Y" Foreground="#A7F3D0"
                               FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="15,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Height"     Value="48"/>
                            <Setter Property="Margin"     Value="0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#D1FAE5"/>
                            <Setter Property="FontSize"   Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor"     Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding"    Value="15,0,0,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#065F46"/>
                                    <Setter Property="Foreground" Value="#ECFDF5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Mục 1: Tra cứu Thi Hài (Select Only) -->
                    <Button Command="{Binding ShowThiHaiCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Tra cứu thi hài" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Mục 2: Cảnh Báo (Select Only) -->
                    <Button Command="{Binding ShowCanhBaoCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Cảnh báo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Mục 3: Hồ Sơ Khám Nghiệm (Add + Update) -->
                    <Button Command="{Binding ShowHoSoCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Hồ sơ khám nghiệm" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Border Height="1" Background="#065F46" Margin="0,16"/>

                    <!-- Ghi chú quyền hạn -->
                    <Border Background="#022C22" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Quyền hạn của bạn:" Foreground="#6EE7B7"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Foreground="#A7F3D0" FontSize="11" TextWrapping="Wrap">
                                <Run Text="✔ Xem thi hài"/>
                                <LineBreak/>
                                <Run Text="✔ Xem cảnh báo"/>
                                <LineBreak/>
                                <Run Text="✔ Thêm / Sửa hồ sơ KB"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Đăng Xuất -->
                <StackPanel Grid.Row="2" Margin="15,0,15,30">
                    <Button Content="⬅ Đăng Xuất"
                            Command="{Binding LogOutCommand}"
                            CommandParameter="{Binding ElementName=wndDoctor}"
                            Height="45" Background="#DC2626" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"
                            Margin="0,5" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== NỘI DUNG CHÍNH ===== -->
        <Grid Grid.Column="1" Background="#F0FDF4">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
