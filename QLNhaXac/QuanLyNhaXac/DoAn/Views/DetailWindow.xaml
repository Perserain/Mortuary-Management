<Window x:Class="DoAn.QuanLy.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAn.QuanLy"
        mc:Ignorable="d"
        Title="DetailWindow" Height="550" Width="800">
    <Grid Background="#F0F8FF">
        <StackPanel Margin="20">
            <TextBlock x:Name="txtTitle" Text="CHI TIẾT THÔNG TIN" 
                       FontSize="24" FontWeight="Bold" Foreground="#2E8B57" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel x:Name="pnlContent" Orientation="Vertical">
            </StackPanel>

            <Button Content="Đóng" Width="100" Height="35" Margin="0,30,0,0" 
                    Background="#FF6B6B" Foreground="White" FontWeight="Bold"
                    Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
