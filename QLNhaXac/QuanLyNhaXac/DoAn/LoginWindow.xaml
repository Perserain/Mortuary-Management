<Window x:Class="DoAn.QuanLy.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAn.QuanLy"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Tên đăng nhập" HorizontalAlignment="Left" Margin="256,107,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.474,0.464" Height="48" Width="284" FontWeight="Bold" FontSize="18"/>
        <TextBox x:Name="txtUser" HorizontalAlignment="Left" Margin="404,119,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="186" FontSize="16"/>
        <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" HorizontalAlignment="Left" Margin="317,218,0,0" VerticalAlignment="Top" Click="btnLogin_Click" Height="38" Width="124" FontWeight="Bold" FontSize="18"/>
        <Label Content="Mật khẩu" HorizontalAlignment="Left" Margin="256,148,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.474,0.464" Height="48" Width="284" FontWeight="Bold" FontSize="18"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="404,160,0,0" VerticalAlignment="Top" Width="186" Height="22"/>
        <Label Content="QUẢN LÝ DANH SÁCH NHÀ XÁC" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="36" Foreground="#2E4053"/>
        <Button x:Name="btnRegister" Content="ĐĂNG KÝ" HorizontalAlignment="Left" Margin="497,218,0,0" VerticalAlignment="Top" Height="39" Width="126" FontWeight="Bold" FontSize="18" Background="#FFECED20" Click="btnRegister_Click"/>

    </Grid>
</Window>
