<Window x:Class="DoAn.QuanLy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phần Mềm Quản Lý Nhà Xác" Height="650" Width="1100" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2E4053">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="QUẢN LÝ NHÀ XÁC" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="btnBacSi" Content="👨‍⚕️ BÁC SĨ" Click="BtnBacSi_Click" Height="45" Margin="0,5" Background="#1ABC9C" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                <Button x:Name="btnHoSo" Content="📂 HỒ SƠ" Click="BtnHoSo_Click" Height="45" Margin="0,5" Background="#34495E" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                <Button x:Name="btnDichVu" Content="💉 DỊCH VỤ" Click="BtnDichVu_Click" Height="45" Margin="0,5" Background="#34495E" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                <Button x:Name="btnThiHai" Content="⚰️ THI HÀI" Click="BtnThiHai_Click" Height="45" Margin="0,5" Background="#34495E" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                <Button x:Name="btnNganKeo" Content="🗄️ NGĂN KÉO" Click="BtnNganKeo_Click" Height="45" Margin="0,5" Background="#34495E" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnSuDung" Content="💳 DỊCH VỤ ĐÃ MUA" Click="BtnSuDung_Click" Height="45" Margin="0,5" Background="#34495E" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Border Height="115"/>
                <Button x:Name="btnCheckSize" Content="CHECK DB SIZE" Height="35" Background="#696969" Foreground="White" FontSize="16" FontWeight="Bold" Click="BtnCheckSize_Click" Cursor="Hand"/>
                <Button Content="🚪 ĐĂNG XUẤT" Click="BtnLogOut_Click" Height="45" Margin="0,5" Background="#E74C3C" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="#F2F4F4">
            <ContentControl x:Name="MainContent" Margin="10"/>
        </Grid>
    </Grid>
</Window>
 