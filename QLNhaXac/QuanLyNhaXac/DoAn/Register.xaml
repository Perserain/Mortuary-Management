<Window x:Class="DoAn.QuanLy.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Ký Tài Khoản" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Thông tin đăng ký" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="36" Foreground="#FF429063"/>

        <StackPanel Margin="114,79,114,79" Background="LightGreen">
            <Label Content="Username: " Margin="10,10,10,0" FontWeight="Bold"/>

            <TextBox x:Name="TxtUsername_Re" Width="500" Height="30" Padding="5" Margin="10,0,10,10" VerticalContentAlignment="Center"/>

            <Label Content="Password: " Margin="10,0,10,0" FontWeight="Bold"/>

            <PasswordBox x:Name="TxtPassword_Re" Width="500" Height="30" Padding="5" Margin="10,0,10,10" VerticalContentAlignment="Center"/>

            <Button x:Name="btnDangKy" Content="ĐĂNG KÝ" Width="150" Height="40" Margin="10,20,10,10" 
                    Background="#FF429063" Foreground="White" FontWeight="Bold" FontSize="16"
                    Click="btnDangKy_Click"/>
        </StackPanel>
    </Grid>
</Window>