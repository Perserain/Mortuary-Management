<Window x:Class="DoAn.KhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cổng Tra Cứu Thông Tin - Khách Hàng" Height="650" Width="1100" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="CỔNG TRA CỨU KHÁCH HÀNG" Foreground="#F39C12" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" TextWrapping="Wrap" TextAlignment="Center"/>

                <Button x:Name="btnTraCuu" Content="🔍 TÌM NGƯỜI THÂN" Click="BtnTraCuu_Click" Height="45" Margin="0,5" Background="#1ABC9C" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                <Button x:Name="btnDichVu" Content="💰 BẢNG GIÁ DỊCH VỤ" Click="BtnDichVu_Click" Height="45" Margin="0,5" Background="#34495E" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                <Border Height="250"/>

                <Button Content="🚪 ĐĂNG XUẤT" Click="BtnLogOut_Click" Height="45" Margin="0,5" Background="#E74C3C" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="#F2F4F4">
            <ContentControl x:Name="MainContent" Margin="10"/>
        </Grid>
    </Grid>
</Window>